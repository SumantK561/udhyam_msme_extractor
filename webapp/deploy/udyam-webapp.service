[Unit]
Description=Udyam MSME Public Search API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/udhyam_msme_extractor/webapp/backend
ExecStart=/home/ubuntu/udhyam_msme_extractor/webapp/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
